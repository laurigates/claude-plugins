{
  "description": "documentation-plugin hooks - public-repo leak gate (asks before internal identifiers are published to a public GitHub repo)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/public-repo-leak-gate.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request|mcp__github__update_pull_request|mcp__github__add_issue_comment|mcp__github__update_issue_comment|mcp__github__issue_write|mcp__github__create_or_update_file|mcp__github__push_files|mcp__github__add_comment_to_pending_review|mcp__github__add_reply_to_pull_request_comment|mcp__github__pull_request_review_write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/public-repo-leak-gate.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
