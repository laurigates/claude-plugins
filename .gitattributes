# Git attributes — merge, diff, and checkout behavior by path.
# See .claude/rules/ and docs; companion to scripts/resolve-additive-conflicts.py
# and .github/workflows/auto-resolve-conflicts.yml.

# --- Line endings -----------------------------------------------------------
# Normalize all text to LF in the repo. Protects the ~200 shell hooks/check
# scripts from CRLF corruption (a CRLF shebang line silently breaks execution).
# No-op on the current tree (already 100% LF), so it adds safety without churn.
* text=auto eol=lf
*.sh text eol=lf

# --- No union merges ---------------------------------------------------------
# docs/regression-ledger.md was marked `merge=union` so parallel PRs could each
# append a row. Only local git runs merge drivers; GitHub's server-side merge
# (`gh pr update-branch`, the mergeability check, "Update branch") ignores them,
# so those PRs still conflicted on GitHub (#2947). The ledger is now one file
# per entry under docs/regression-ledger/, so parallel PRs add different paths
# and need no driver. A stale branch that still appends to the old page now
# conflicts loudly, and scripts/check-regression-ledger.sh reports the row.

# --- Custom structural merge drivers ----------------------------------------
# The blueprint manifest is rewritten by sync-ids/autorun on every run, so two
# branches that each ran a task conflict on timestamps and run counters. The
# blueprint-plugin driver merges the parsed JSON (later run wins, registry
# entries union, a genuine disagreement still conflicts). Its command lives in
# git config, registered per clone by blueprint-plugin's
# hooks/register-merge-driver.sh; an unregistered clone falls back to the
# ordinary line merge. See blueprint-plugin/README.md § Manifest Merge Driver.
docs/blueprint/manifest.json merge=blueprint-manifest

# --- Generated files (GitHub linguist) -------------------------------------
# Collapse in PR diffs and exclude from language stats. These are build output
# or tool-owned — reviewers should not wade through their churn, and a conflict
# in them is resolved by regenerating, not by hand-merging. (linguist-generated
# only affects GitHub's display; it changes no merge behavior — so it is safe
# even where `merge=union` would be wrong.)
**/CHANGELOG.md linguist-generated=true
.release-please-manifest.json linguist-generated=true
# Rendered from the committed .d2 sources (the .d2 is the reviewable artifact).
docs/diagrams/*.svg linguist-generated=true
