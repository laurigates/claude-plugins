{
  "name": "{{ project-name }}",
  "version": "0.1.0",
  "description": "{{ description }}",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
