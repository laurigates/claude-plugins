  "keywords": [
    "foundryvtt",
    "foundry-vtt",
    "module"
  ],
  "author": "{{ author_name }}",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^2.2.0",
    "vitest": "^3.0.0"
  }
}
